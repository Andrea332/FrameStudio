; Added to the installer script generated by CPack.
; FrameStudio was called Video Compressor up to version 2.4, and installs over it (same AppId): remove the old
; program and its shortcuts.
[InstallDelete]
Type: files; Name: "{app}\VideoCompressor.exe"
Type: files; Name: "{autoprograms}\Video Compressor.lnk"
Type: files; Name: "{autodesktop}\Video Compressor.lnk"
